{
  "expo": {
    "name": "PlanMoney",
    "slug": "PlanMoney",
    "version": "2.2.2",
    "orientation": "portrait",
    "scheme": "planmoney",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSFaceIDUsageDescription": "Use Face ID to securely login to HappISign"
      }
    },
    "android": {
      "allowBackup": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#012744"
      },
      "permissions": [
        "NOTIFICATIONS"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "data": {
            "scheme": "planmoney"
          },
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "googleServicesFile": "./google-services.json",
      "package": "com.aashadsolkar.PlanMoney",
      "softwareKeyboardLayoutMode": "pan"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.ico"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon-dark.png",
          "imageResizeMode": "contain",
          "backgroundColor": "#012744",
          "imageWidth": 200,
           "preventAutoHide": true
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/ic_notification.png",
          "color": "#ffff",
          "enableVibration": true,
          "enableLights": true,
          "enableBackgroundRemoteNotifications": true
        }
      ],
      "expo-font",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a5c5825f-1608-4a27-bc9a-08de576c1467"
      }
    }
  }
}
